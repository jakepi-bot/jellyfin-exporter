<Project>
  <!--
    Single source of truth for the plugin version.
    Also pins the Jellyfin server packages the plugin compiles against.
    Bump <Version> here, tag the repo v<Version>, and the release workflow
    stamps the same value into meta.json and manifest.json.
  -->
  <PropertyGroup>
    <Version>0.6.0.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <JellyfinVersion>12.4.0</JellyfinVersion>
    <JellyfinTargetAbi>12.4.0.0</JellyfinTargetAbi>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
</Project>
